{
  "name": "wan-chun-gong-service-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:public": "vite --host 0.0.0.0 --mode public",
    "dev:admin": "vite --host 0.0.0.0 --mode admin",
    "build": "npm run build:public",
    "build:public": "tsc -b && vite build --mode public",
    "build:admin": "tsc -b && vite build --mode admin",
    "build:sites": "npm run build:public && node scripts/prepare-sites-build.mjs --surface public",
    "build:sites:admin": "npm run build:admin && node scripts/prepare-sites-build.mjs --surface admin",
    "preview": "vite preview --host 0.0.0.0",
    "test:sites-worker": "node scripts/test-sites-worker.mjs --surface public",
    "test:sites-worker:admin": "node scripts/test-sites-worker.mjs --surface admin"
  },
  "dependencies": {
    "@line/liff": "^2.27.1",
    "@vitejs/plugin-react": "^4.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "vite": "^5.4.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
